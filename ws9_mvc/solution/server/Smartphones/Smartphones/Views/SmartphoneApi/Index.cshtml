<!DOCTYPE html>
<html>

<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>Smartphones</title>
    <meta name="description" content="Smartphones">
    <meta name="viewport" content="width=device-width, initial-scale=1">
</head>

<body>
    <h3>HTML list</h3>
    <ul>
        <li>1</li>
        <li>2</li>
        <li>3</li>
        <li>4</li>
        <li>5</li>
    </ul>
    <h3>Hint</h3>
    @{
        var text = "This is some C# code";
        @:
        <p>text</p>
        @:
        <p>@text</p>
    }
    <h3>C# generated list</h3>
    <ul>
        @{
            for (int i = 1; i <= 5; i++)
            {
                @:
                <li>@i</li>
            }
        }
    </ul>
    <form method="get" action="list">
        <input type="submit" value="List phones">
    </form>
</body>

</html>